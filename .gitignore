# Nesting1D - Git除外設定
# 役割: Python生成物、仮想環境、秘密情報、利用者データ等をGit管理から除外する。
# 更新日: 2026-08-10

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
.venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Application data
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

AGENTS.md.backup

data/*
!data/.gitkeep
